# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for canonical URLs, sitemap,
# robots.txt and Open Graph. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact channels — each is optional; links only render when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# International format, digits only or with +, e.g. +919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=

# ─────────────────────────────────────────────────────────────
# Project enquiry delivery (server-only)
# Configure at least one channel, otherwise the form reports that
# enquiries are not connected (it never fakes success).
# ─────────────────────────────────────────────────────────────
# Option A — webhook: receives a JSON POST { type, submittedAt, enquiry }.
# Works with Zapier, Make, n8n, Slack workflows or your CRM.
LEAD_WEBHOOK_URL=

# Option B — email via Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated recipients
LEAD_NOTIFY_EMAIL=
# Must be on a domain verified in Resend, e.g. "Studio <hello@yourdomain.com>"
LEAD_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────
# Analytics — scripts load only when an ID is present
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
