# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for canonical URLs, sitemap,
# robots.txt and Open Graph. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact channels — each is optional; links only render when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# International format, digits only or with +, e.g. +919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=

# ─────────────────────────────────────────────────────────────
# Project enquiry delivery (server-only — never exposed to the browser)
# Configure at least one channel, otherwise the form reports that
# enquiries are not connected (it never fakes success).
# ─────────────────────────────────────────────────────────────
# Primary — email via Resend (https://resend.com)
#   Visitor → contact form → server action → Resend → LEAD_NOTIFY_EMAIL
# The visitor's address is set as Reply-To, so replying goes to them.
RESEND_API_KEY=
# Recipient inbox(es), comma-separated — the studio's enquiry inbox.
LEAD_NOTIFY_EMAIL=
# Sender on a domain verified in Resend, e.g. "Brewed Views <enquiries@yourdomain.com>".
# If unset, Resend's test sender onboarding@resend.dev is used, which can only
# deliver to the email address that owns the Resend account.
LEAD_FROM_EMAIL=

# Optional — webhook: receives a JSON POST { type, submittedAt, enquiry }.
# Works with Zapier, Make, n8n, Slack workflows or your CRM.
LEAD_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Analytics — scripts load only when an ID is present
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
